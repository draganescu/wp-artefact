{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"landingPage": "/wp-admin/edit.php?post_type=artifact",
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Artifacts",
				"blogdescription": "Byte-identical documents, published by agents",
				"permalink_structure": "/%postname%/"
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "wp-artifacts/wp-artifacts.php"
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; flush_rewrite_rules( false );"
		},
		{
			"step": "login",
			"username": "admin",
			"password": "password"
		}
	]
}
